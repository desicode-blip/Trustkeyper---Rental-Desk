rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return signedIn() && email() in ['info@trustkeyper.com', 'amanmaheshwari900@gmail.com']; }
    function isMember() { return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/access/$(email()))); }

    // Team list: members can check it, only admins change it.
    match /access/{who} { allow read: if isAdmin() || (signedIn() && who == email()); allow write: if isAdmin(); }
    // A lead is visible to admins and to the people listed in its viewers (kept by the leadViewers function).
    function sees(d) { return isAdmin() || (isMember() && email() in d.get('viewers', [])); }
    // Profiles: each member reads and writes only their own; admins read all.
    match /profiles/{who} {
      allow read: if isAdmin() || (isMember() && who == email());
      allow write: if isMember() && who == email() && request.resource.data.email == email();
    }
    // Homes shared with tenants: anyone with the exact link can open one; nobody can list them.
    match /shares/{id} { allow get: if true; allow list, write: if isMember(); }
    // Visits booked from a shared link. Tenants create (status booked), read by id, cancel, mark visited, say liked.
    match /visits/{id} {
      allow get: if true;
      allow list: if isAdmin() || sees(resource.data);
      allow create: if isMember() || (
        request.resource.data.keys().hasOnly(['sid','tid','pid','at','name','phone','code','status','createdAt'])
        && request.resource.data.status == 'booked'
        && request.resource.data.code is string && request.resource.data.code.size() == 4
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && exists(/databases/$(database)/documents/shares/$(request.resource.data.sid))
        && get(/databases/$(database)/documents/shares/$(request.resource.data.sid)).data.tid == request.resource.data.tid
        && get(/databases/$(database)/documents/shares/$(request.resource.data.sid)).data.pid == request.resource.data.pid);
      allow update: if isAdmin() || (sees(resource.data) && request.resource.data.get('viewers', []) == resource.data.get('viewers', [])) || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','liked','updatedAt'])
        && resource.data.status in ['booked','visited']
        && request.resource.data.status in ['cancelled','visited','booked']
        && (!('liked' in request.resource.data) || request.resource.data.liked in ['yes','no']));
      allow delete: if isAdmin();
    }
    // Quick replies from a shared link ("Not for me").
    match /replies/{id} {
      allow create: if request.resource.data.keys().hasOnly(['sid','tid','pid','kind','at']) && request.resource.data.kind == 'notforme'
        && exists(/databases/$(database)/documents/shares/$(request.resource.data.sid));
      allow read: if sees(resource.data);
      allow update: if isAdmin() || (sees(resource.data) && request.resource.data.get('viewers', []) == resource.data.get('viewers', []));
      allow delete: if isAdmin();
    }
    // Desk data
    match /leads/{id} {
      allow read: if sees(resource.data);
      allow create: if isAdmin() || (isMember() && request.resource.data.get('viewers', []) == [email()]);
      allow update: if isAdmin() || (sees(resource.data) && request.resource.data.get('viewers', []) == resource.data.get('viewers', []));
      allow delete: if isAdmin();
    }
    match /config/{id} { allow read, write: if isMember(); }
    // Feedback: each person writes and reads their own; admins read all and set status/reply.
    match /feedback/{id} {
      allow create: if isMember() && request.resource.data.by == email() && request.resource.data.status == 'new';
      allow read: if isAdmin() || (isMember() && (resource.data.by == email() || resource.data.shared == true));
      allow update: if isAdmin() || (isMember() && resource.data.by == email() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shared']));
      allow delete: if isAdmin();
    }
  }
}
